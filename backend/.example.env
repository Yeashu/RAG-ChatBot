# OpenRouter / OpenAI-compatible LLM
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=xiaomi/mimo-v2.5

# Embedding Model (via OpenRouter)
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
DIMENSIONS=768

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=notebook-rag

# RAG Config
TOP_K=5
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# App
MAX_FILE_SIZE_MB=10

# Prompt
SYSTEM_PROMPT=Answer ONLY from provided context. If answer is missing, say you could not find it in the document.